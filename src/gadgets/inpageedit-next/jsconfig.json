{
    "include": ["*.js", "*.d.ts"],
    "compilerOptions": {
        "target": "ES6",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "lib": ["ES6", "DOM", "DOM.Iterable"],
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["@inpageedit/core", "types-mediawiki"]
    }
}
