        "banAppeal": {
            "template": "Template:BlockedUserHelp/request",
            "parameters": [
                {
                    "key": "1",
                    "label": {
                        "hans": "封禁信息（自动填写，请勿修改）",
                        "hant": "封鎖資訊（自動填寫，請勿修改）"
                    },
                    "type": "multiline",
                    "readOnly": true
                },
                {
                    "key": "reason",
                    "label": "求助理由",
                    "type": "multiline",
                    "hint": {
                        "hans": "如果您是被防滥用过滤器封禁的，请只填写类似「希望检查缘由」的文字，以免再次被防滥用过滤器阻止编辑。",
                        "hant": "如果您是被防濫用過濾器封鎖的，請只填寫類似「希望檢查緣由」的文字，以免再次被防濫用過濾器阻止編輯。"
                    }
                }
            ]
        },
