{
    "name": "moegirlpediainterfacecodes",
    "repository": {
        "type": "git",
        "url": "https://github.com/MoegirlPediaInterfaceAdmins/MoegirlPediaInterfaceCodes.git"
    },
    "type": "module",
    "private": true,
    "engines": {
        "node": "^24.11"
    },
    "scripts": {
        "test": "run-p --aggregate-output -clx test:*",
        "test:eslint": "eslint src --cache --cache-strategy content --cache-location .cache/ --color --exit-on-fatal-error --max-warnings 0",
        "test:stylelint": "stylelint 'src/**/*.css' --cache --cache-strategy content --cache-location .cache/ --color --max-warnings 0",
        "test:v8r": "node scripts/v8r/index.js",
        "test:mailmap": "node scripts/emailmapChecker/index.js",
        "lint:scripts": "node scripts/eslint/index.js",
        "lint:commit-message": "node scripts/commitLint/index.js commits",
        "lint:pr-title": "node scripts/commitLint/index.js title",
        "format": "run-p --aggregate-output -clx format:*",
        "format:eslint": "npm run test:eslint -- --fix",
        "format:stylelint": "npm run test:stylelint -- --fix",
        "prepare": "node .husky/install.mjs",
        "ci": "rm -rdf node_modules && node scripts/ci/selectRegistry.js && npm ci --registry=\"$(cat .cache/ci-registry)\" --replace-registry-host=always",
        "build": "run-p -l build:*",
        "build:css": "postcss 'src/**/*.css' --base src/ -d dist/ --verbose",
        "prebuild:js": "rm -rf dist",
        "build:js": "npx tsc --project tsconfig.production.json",
        "postbuild:js": "node scripts/injection/index.js && node scripts/minification/terser.js"
    },
    "dependencies": {
        "@actions/artifact": "^6.2.1",
        "@actions/core": "^3.0.1",
        "@annangela/eslint-config": "^15.0.0",
        "@csstools/postcss-is-pseudo-class": "^6.0.0",
        "@csstools/postcss-media-minmax": "^3.0.4",
        "@octokit/auth-action": "^6.0.3",
        "@octokit/auth-app": "^8.3.1",
        "@octokit/auth-unauthenticated": "^7.0.5",
        "@octokit/plugin-retry": "^8.1.1",
        "@octokit/rest": "^22.0.1",
        "@types/echarts": "^5.0.0",
        "@types/ip": "^1.1.3",
        "@types/jquery": "^4.0.1",
        "@types/oojs-ui": "^0.50.0",
        "@types/prismjs": "^1.26.6",
        "autoprefixer": "^10.5.5",
        "browser-pack-flat": "^3.5.0",
        "browserify": "^17.0.1",
        "browserslist": "^4.28.8",
        "common-shakeify": "^1.1.2",
        "concat-stream": "^2.0.0",
        "duplexify": "^4.1.3",
        "envify": "^4.1.0",
        "esmify": "^2.1.1",
        "hash-wasm": "^4.12.0",
        "ip": "^2.0.1",
        "javascript-obfuscator": "^5.6.0",
        "jsonc-parser": "^3.3.1",
        "localforage": "^1.10.0",
        "moment": "^2.30.1",
        "npm-run-all2": "^9.0.3",
        "postcss": "^8.5.28",
        "postcss-cli": "^12.0.0",
        "postcss-discard-comments": "^9.0.2",
        "postcss-font-variant": "^5.0.0",
        "postcss-logical": "^9.0.0",
        "postcss-selector-not": "^9.0.0",
        "pretty-bytes": "^7.1.3",
        "semver": "^7.8.5",
        "simple-git": "^3.36.0",
        "terser": "^5.51.2",
        "types-mediawiki": "^2.1.0",
        "typescript": "^6.0.3",
        "uglify-js": "^3.19.3",
        "unassertify": "^3.0.1",
        "yaml": "^2.9.0"
    },
    "devDependencies": {
        "@annangela/eslint-formatter-gha": "^6.1.1",
        "@annangela/eslint-plugin-prefer-reflect": "^6.0.0",
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@commitlint/lint": "^21.2.2",
        "@commitlint/load": "^21.2.2",
        "@csstools/stylelint-formatter-github": "^2.0.0",
        "@inpageedit/core": "^0.18.0",
        "eslint": "^10.10.0",
        "eslint-plugin-prefer-arrow-functions": "^3.10.2",
        "husky": "^9.1.7",
        "stylelint": "^17.15.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-plugin-use-baseline": "^1.4.6",
        "v8r": "^6.1.0"
    }
}
