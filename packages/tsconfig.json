{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "../node_modules/@annangela/eslint-config/dist/tsconfigs/tsconfig.browser.json",
    "compilerOptions": {
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        // MoeUpload 源码保持其既有的可选属性传递方式
        "exactOptionalPropertyTypes": false,
        "paths": {
            "@/*": [
                "./MoeUpload/src/*"
            ]
        },
        "jsx": "react",
        "types": [
            "jquery",
            "oojs-ui",
            "node"
        ]
    },
    "include": [
        "*/src",
        "*/tests",
        "*/vitest.config.ts",
        "../src/@types/site-lib.d.ts",
        "../node_modules/moment/moment.d.ts",
        "../node_modules/types-mediawiki"
    ]
}
